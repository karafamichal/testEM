    <string name="privacy_title">Two optional features</string>
    <string name="privacy_community_title">Help with bus positions</string>
    <string name="privacy_community_body">Many buses don\'t report where they are. Riders can: with buttons on the follow notification, or automatically from their phone while riding. Only the bus, the stop and the time are sent, with a random ID that changes for every bus. Never your location.</string>
    <string name="privacy_catch_title">Will I catch it?</string>
    <string name="privacy_catch_body">While you wait for a bus you follow, the app uses your location to work out the walk to the stop and tells you when to leave. Your location stays on this phone.</string>
    <string name="privacy_hint">You can change both later in Account > Community and location.</string>
